# Microsoft Graph app registration (delegated flow)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id

# Optional: client secret for confidential client flow (if using daemon pattern)
# GRAPH_CLIENT_SECRET=your-client-secret

# User mailbox to triage
MAILBOX_USER_PRINCIPAL_NAME=you@company.com

# Poll settings
POLL_SECONDS=60
TRIAGED_CATEGORY=triaged
MARK_READ=true

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# LLM (MVP uses Azure OpenAI)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Optional: cap email body length sent to LLM
MAX_BODY_CHARS=8000
